# Python build and cache files
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Generated solver outputs
outputs/

# Slurm job stdout/stderr
logs/

# Captured/copied spike traces (large binary .npy data, not source)
examples/input_trace/
*.json
*.yaml
*.lp
*.mps
*.sol
*.log

# These examples/ directories hold hand-written config source, so the
# extension rules above do not apply to them.
!examples/arch/**
!examples/cache/**
!examples/node_mapspace/**
!examples/workloads/**
!examples/schedules/**

# examples/cachesim/ holds committed example traces: source-controlled
# fixtures, not captured data, so the *.json rule above does not apply to them
# either. Scoped to the fixture extension rather than to `**`, which would also
# re-include the __pycache__/ that line 2 ignores.
!examples/cachesim/*.json

# examples/input_trace/ is ignored above as captured data, but the loas subset under it
# is a deliberate 13.6 MB fold of 5 samples (of 10,000) cut from the full
# captures on Delta, so the pipeline runs from the repo rather
# than from a sibling capture repo that no longer exists.
!examples/input_trace/
!examples/input_trace/loas/**

# Delta's 500-sample capture suite is generated data, not source.
examples/input_trace/delta/

# The campaign's sweep configuration is source-controlled.
!zoo/demo_l2pf/l2pf_demo.json

# Local Gurobi installation and license files
gurobi_server1302/
gurobi.lic
*.lic

# Compiled native binaries (build with: cd <dir> && make)
src/lays/nocsim/eventsim/eventsim
src/lays/weight_trace_gen/gustavsnn/gustavgen
src/lays/weight_trace_gen/loas/loasgen
src/lays/weight_trace_gen/prosperity/prosperitygen
src/lays/weight_trace_gen/ptb/ptbgen
src/lays/weight_trace_gen/spinalflow/spinalflowgen

# Local editor and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Local agent skills
.agents/skills/
.claude/skills/
.codex/skills/

# Subagent-driven-development scratch (progress ledger, briefs, reports)
.superpowers/

# Core dumps from crashed sweep runs
core.*

# local baseline outputs for the cleanup sprint (not tracked)
.baseline/

# Default NEURO_CACHE_DATA (src/lays/util.py data_root): data kept outside git
/data/
