# Python build and cache files
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Generated solver outputs
outputs/

# Slurm job stdout/stderr
logs/

# Captured/copied spike traces (large binary .npy data, not source)
input_trace/
*.json
*.yaml
*.lp
*.mps
*.sol
*.log

# configs/ holds hand-written config source, not captured data, so the
# extension rules above do not apply to it.
!configs/**

# src/cachesim/examples/ holds committed example traces: source-controlled
# fixtures, not captured data, so the *.json rule above does not apply to them
# either. Scoped to the fixture extension rather than to `**`, which would also
# re-include the __pycache__/ that line 2 ignores.
!src/cachesim/examples/*.json

# input_trace/ is ignored above as captured data, but the loas subset under it
# is a deliberate 13.6 MB fold of 5 samples (of 10,000) cut by
# scripts/subset_input_traces.py, so the pipeline runs from the repo rather
# than from a sibling capture repo that no longer exists.
!input_trace/
!input_trace/loas/**

# Local Gurobi installation and license files
gurobi_server1302/
gurobi.lic
*.lic

# Compiled native binaries (build with: cd <dir> && make)
src/nocsim/eventsim/eventsim
src/weight_trace_gen/gustavsnn/gustavgen
src/weight_trace_gen/loas/loasgen
src/weight_trace_gen/prosperity/prosperitygen
src/weight_trace_gen/ptb/ptbgen
src/weight_trace_gen/spinalflow/spinalflowgen

# Local editor and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Local agent skills
.agents/skills/
.claude/skills/
.codex/skills/

# Subagent-driven-development scratch (progress ledger, briefs, reports)
.superpowers/

# Core dumps from crashed sweep runs
core.*

# local baseline outputs for the cleanup sprint (not tracked)
.baseline/

# Default NEURO_CACHE_DATA (src/util.py data_root): data kept outside git
/data/
