# Python build and cache files
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Generated solver outputs
outputs/

# Slurm job stdout/stderr
logs/

# Captured/copied spike traces (large binary .npy data, not source)
input_trace/
*.json
*.yaml
*.lp
*.mps
*.sol
*.log

# configs/ holds hand-written config source, not captured data, so the
# extension rules above do not apply to it.
!configs/**

# src/wcache/examples/ holds committed example traces: small slices of the
# generated corpus, cut by make_examples.py so plan unit A3 can be built and
# reviewed against corpus-shaped data. Source-controlled fixtures, not captured
# data, so the *.json rule above does not apply to them either. Scoped to the
# fixture extension rather than to `**`, which would also re-include the
# __pycache__/ that line 2 ignores.
!src/wcache/examples/*.json

# profiling/*/grids/ holds hand-written sweep tier definitions: the files that
# decide every sweep point. Config source, not captured data, so the *.json rule
# above does not apply to them.
!profiling/**/grids/*.json

# input_trace/ is ignored above as captured data, but the loas subset under it
# is a deliberate 13.6 MB fold of 5 samples (of 10,000) cut by
# scripts/subset_input_traces.py, so the pipeline runs from the repo rather
# than from a sibling capture repo that no longer exists.
!input_trace/
!input_trace/loas/**

# Local Gurobi installation and license files
gurobi_server1302/
gurobi.lic
*.lic

# Compiled native binaries (build with: cd <dir> && make)
src/nocsim/eventsim/eventsim
src/archmodels/gustavsnn/gustavgen
src/archmodels/loas/loasgen
src/archmodels/prosperity/prosperitygen
src/archmodels/ptb/ptbgen
src/archmodels/spinalflow/spinalflowgen
src/cachesim/cache_replay
src/cachesim/cache_replay_hierarchical
src/cachesim/cache_sweep_hierarchical
dump/profiling/*/native/cache_sweep*
!dump/profiling/*/native/*.cpp

# Regenerated weight-trace data (large, reproducible from tracegen.py)
weight_traces/

# Per-unit cache-sweep results (large, reproducible from cache_sweep.py)
dump/profiling/*/results*/
dump/profiling/*/cache_sweep_results*.csv
profiling/0803_l1_l2_cache/results/
profiling/0803_l1_l2_cache/per_core/
profiling/0803_l1_l2_cache/hierarchical_cache_results.csv
profiling/0803_l1_l2_cache/artifact/neuro-cache-dashboard.zip

# Local editor and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Local agent skills
.agents/skills/
.claude/skills/
.codex/skills/

# Subagent-driven-development scratch (progress ledger, briefs, reports)
.superpowers/
