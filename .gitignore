# Python build and cache files
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Generated solver outputs
outputs/

# Slurm job stdout/stderr
logs/

# Captured/copied spike traces (large binary .npy data, not source)
input_trace/
*.json
*.yaml
*.lp
*.mps
*.sol
*.log

# configs/ holds hand-written config source, not captured data, so the
# extension rules above do not apply to it.
!configs/**

# src/wcache/examples/ holds committed example traces: small slices of the
# generated corpus, cut by make_examples.py so plan unit A3 can be built and
# reviewed against corpus-shaped data. Source-controlled fixtures, not captured
# data, so the *.json rule above does not apply to them either. Scoped to the
# fixture extension rather than to `**`, which would also re-include the
# __pycache__/ that line 2 ignores.
!src/wcache/examples/*.json

# profiling/*/grids/ holds hand-written sweep tier definitions: the files that
# decide every sweep point. Config source, not captured data, so the *.json rule
# above does not apply to them.
!profiling/**/grids/*.json

# input_trace/ is ignored above as captured data, but the loas subset under it
# is a deliberate 13.6 MB fold of 5 samples (of 10,000) cut by
# scripts/subset_input_traces.py, so the pipeline runs from the repo rather
# than from a sibling capture repo that no longer exists.
!input_trace/
!input_trace/loas/**

# Local Gurobi installation and license files
gurobi_server1302/
gurobi.lic
*.lic

# Compiled native binaries (build with: cd <dir> && make)
src/nocsim/eventsim/eventsim
src/archmodels/gustavsnn/gustavgen
src/archmodels/loas/loasgen
src/archmodels/prosperity/prosperitygen
src/archmodels/ptb/ptbgen
src/archmodels/spinalflow/spinalflowgen
src/cachesim/cache_replay
src/cachesim/cache_replay_hierarchical
src/cachesim/cache_sweep_hierarchical
dump/profiling/*/native/cache_sweep*
!dump/profiling/*/native/*.cpp

# Regenerated weight-trace data (large, reproducible from tracegen.py)
weight_traces/

# Per-unit cache-sweep results (large, reproducible from cache_sweep.py)
dump/profiling/*/results*/
dump/profiling/*/cache_sweep_results*.csv
profiling/0803_l1_l2_cache/results/
profiling/0803_l1_l2_cache/per_core/
profiling/0803_l1_l2_cache/hierarchical_cache_results.csv
profiling/0803_l1_l2_cache/artifact/neuro-cache-dashboard.zip

# The 0820 campaign's outputs, by the same rule as 0803's above: per-unit result
# files, the merged CSV, and the two local demo CSVs. All are regenerated by
# profiling/0820_phaseD_spad_vs_cache/run_sweep.py in well under a second on the
# fixture slices, and on Delta they are the campaign's own output rather than
# source. grids/ stays tracked through the rule near the top of this file.
profiling/0820_phaseD_spad_vs_cache/results/
profiling/0820_phaseD_spad_vs_cache/spad_vs_cache.csv
profiling/0820_phaseD_spad_vs_cache/demo_results.csv
profiling/0820_phaseD_spad_vs_cache/dup.csv

# Local editor and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Local agent skills
.agents/skills/
.claude/skills/
.codex/skills/

# Subagent-driven-development scratch (progress ledger, briefs, reports)
.superpowers/

# 2026-08-23 stagewise verification. The repo-wide `outputs/`, `*.json`,
# `*.yaml`, `*.log` and `input_trace/` rules above would swallow this
# campaign's staged inputs, manifests, schedules and reports, which are the
# reviewable record of the run. Re-include the tree, then exclude only the bulk
# regenerable data: the weight traces (103 MB), the raw WCTS dumps (194 MB) and
# the copied .npy spike slices, all reproducible from the run scripts.
!profiling/0823_stagewise_verify/**/inputs/
!profiling/0823_stagewise_verify/**/inputs/**
!profiling/0823_stagewise_verify/**/outputs/
!profiling/0823_stagewise_verify/**/outputs/**
!profiling/0823_stagewise_verify/input_trace_audit/**
profiling/0823_stagewise_verify/stage2_weight_trace/outputs/weight_traces/
profiling/0823_stagewise_verify/stage2_weight_trace/outputs/stream/*.wcts
profiling/0823_stagewise_verify/stage2_weight_trace/inputs/input_trace/

# Stage 4 weight-trace streams: 1.5 GB of binary, regenerable byte-exactly
# from Stage 2 inputs by scripts/generate_weight_traces.py (verified 2026-08-25).
profiling/0823_stagewise_verify/stage4_wcache/inputs/streams/*.wcts

# wcache debugging instruments: the cache-state log and the line trace, plus
# the aligned text views to_txt.py renders from them. All are regenerable by
# `wcache_run --cache-state` / `--line-trace`, and a whole layer runs to
# hundreds of megabytes. The README, to_txt.py and the .json config beside them
# are the reviewable record; the outputs are not.
debug/wcache_instruments/*.csv
debug/wcache_instruments/*.txt
